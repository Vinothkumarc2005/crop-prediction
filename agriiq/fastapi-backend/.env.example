# ── PostgreSQL ────────────────────────────────────────────────────────────────
# psycopg v3 connection string (NOT JDBC format)
DATABASE_URL=postgresql://agriiq:agriiq_secret@localhost:5432/agriiq

# ── JWT ───────────────────────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION: use a 256-bit random string
JWT_SECRET=change_me_in_production_must_be_at_least_256_bits_long_abcdefghijklmnop
JWT_EXPIRATION_SECONDS=86400
JWT_ALGORITHM=HS256

# ── ML Model ─────────────────────────────────────────────────────────────────
MODEL_DIR=ml_models

# ── Provider switches ─────────────────────────────────────────────────────────
# mock = built-in synthetic data (default for development)
# live = real external APIs (requires API keys below)
NDVI_PROVIDER=mock
SOIL_PROVIDER=mock

# ── Live API keys (only used when provider=live) ──────────────────────────────
# Sentinel Hub (NDVI from Sentinel-2)
# Register at: https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Agmarknet (Mandi prices)
# Apply at: https://agmarknet.gov.in/
AGMARKNET_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins (pydantic-settings parses this automatically)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
